/* The NV2A (native/dev/nv2a.c): its register file and instance memory as
 * the 4 KiB pages that aren't all zero (each: its index, then its bytes),
 * the vblank count and frame period; PTIMER's time base (v2); the AV mode
 * and the title's shape (v3). */
NC_SECTION(NV2A)

NC_REC(NcNv2aState, 48)
NC_F(NcNv2aState, vblanks, U64, 1, 1, 0)
NC_F(NcNv2aState, frame_ns, U64, 1, 1, 0)
NC_F(NcNv2aState, npages, U32, 1, 1, 0)
NC_F(NcNv2aState, pt_set, U32, 1, 2, 0)
NC_F(NcNv2aState, pt_ticks, U64, 1, 2, 0)
NC_F(NcNv2aState, pt_ns, U64, 1, 2, 0)
NC_F(NcNv2aState, av_mode, U32, 1, 3, 0)
NC_F(NcNv2aState, av_title, U32, 1, 3, 0)
NC_END(NcNv2aState)
